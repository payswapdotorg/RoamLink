# =============================================================================
# RoamLink ENVIRONMENT TEMPLATE - production (RL-099)
# spec/deployment.md §6: production.
# VALUES STAY EMPTY. Real values live ONLY in the production secret store,
# entered via the operator console (Vercel dashboard/CLI or the secret
# manager) - never in files, tickets, chats or logs. Production secrets are
# UNIQUE to production (database, Redis, QStash, R2, ADCOS, webhook secrets).
# Secret handling: rotate via QStash current/next signing keys; scope R2 to
# the production bucket; restrict Neon access to production endpoints.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
ROAMLINK_API_BASE_URL=
ROAMLINK_PUBLIC_API_URL=

# --- Durable source of truth: Neon PostgreSQL (RL-095) -----------------------
# Production uses verify-full sslmode where the driver supports it.
DATABASE_URL=
NEON_DIRECT_URL=

# --- Bounded accelerator: Upstash Redis (RL-096) -----------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Retryable async delivery: Upstash QStash (RL-097) -----------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# --- Large artifacts: Cloudflare R2 (RL-098) ---------------------------------
# Production R2 credentials are SCOPED to the production bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- ADCOS boundary (root env schema, RL-001) --------------------------------
ADCOS_API_BASE_URL=
ADCOS_API_VERSION=
ADCOS_CLIENT_ID=
ADCOS_CLIENT_SECRET=
ADCOS_WEBHOOK_SECRET=
