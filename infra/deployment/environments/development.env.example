# =============================================================================
# RoamLink ENVIRONMENT TEMPLATE - development (RL-099)
# spec/deployment.md §6: local development.
# VALUES STAY EMPTY. Real values go into your local shell / .env (git-ignored).
# Every value here MUST differ from the other environments' credentials.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
ROAMLINK_API_BASE_URL=http://localhost:3000
ROAMLINK_PUBLIC_API_URL=http://localhost:3000

# --- Durable source of truth: Neon PostgreSQL (RL-095) -----------------------
# Pooled endpoint for request paths. See infra/deployment/providers/neon.env.example
DATABASE_URL=
# Direct endpoint for migrations/long workers (own secret name).
NEON_DIRECT_URL=

# --- Bounded accelerator: Upstash Redis (RL-096) - OPTIONAL locally ----------
# Omit to run the non-accelerated path (the system stays correct).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Retryable async delivery: Upstash QStash (RL-097) - OPTIONAL locally ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# --- Large artifacts: Cloudflare R2 (RL-098) - OPTIONAL locally --------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- ADCOS boundary (root env schema, RL-001) --------------------------------
ADCOS_API_BASE_URL=
ADCOS_API_VERSION=
ADCOS_CLIENT_ID=
ADCOS_CLIENT_SECRET=
ADCOS_WEBHOOK_SECRET=
