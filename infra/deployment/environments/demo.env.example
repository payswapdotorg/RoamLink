# =============================================================================
# RoamLink ENVIRONMENT TEMPLATE - demo (RL-099)
# spec/deployment.md §6: the public demo deployment (non-commercial;
# Vercel Hobby terms apply - see ../free-tier-constraints.md).
# VALUES STAY EMPTY. Real values live ONLY in the demo environment's
# secret store. Demo credentials are separate from production AND preview.
# =============================================================================

# --- Public demo accounts (quick action logins) -------------------------------
# ROAMLINK_DEMO_ACCOUNTS: "1"/"true" seeds the PUBLIC demo roster through the
# REAL @roamlink/auth boundary at composition time and renders one-click
# sign-in forms on the login document. The personas are public fixtures of
# the demo environment (their shared password is rendered on the login page
# - it is not secret material); emails use the reserved .example domain so
# they can never collide with a real mailbox. Unset/"0"/"false" seeds
# NOTHING (every other deployment leaves this unset). Any other value
# REFUSES the host boot (fail-closed - an ambiguous gate is never silently
# interpreted). See apps/portal-host/src/demo-accounts.ts for the roster.
ROAMLINK_DEMO_ACCOUNTS=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
ROAMLINK_API_BASE_URL=
ROAMLINK_PUBLIC_API_URL=

# --- Durable source of truth: Neon PostgreSQL (RL-095) -----------------------
DATABASE_URL=
NEON_DIRECT_URL=

# --- Bounded accelerator: Upstash Redis (RL-096) -----------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Retryable async delivery: Upstash QStash (RL-097) -----------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# --- Large artifacts: Cloudflare R2 (RL-098) ---------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Maintenance trigger + worker wiring (RL-107) ----------------------------
# CRON_SECRET: /api/maintenance/daily answers ONLY `Authorization: Bearer
# <CRON_SECRET>` (Vercel cron delivers exactly that). UNSET = the route
# refuses EVERY trigger (fail-closed). Per environment, never shared.
CRON_SECRET=
# ROAMLINK_OUTBOX_DELIVERY_DESTINATION: the HTTPS receiver the worker's
# QStash outbox handoff delivers obligations to. Set + QSTASH_TOKEN ->
# the worker composes the outbox drain; unset -> the drain is honestly
# disabled (records stay PENDING) and readiness reports the degradation.
ROAMLINK_OUTBOX_DELIVERY_DESTINATION=
# ROAMLINK_MAINTENANCE_DESTINATION + QSTASH_TOKEN: when both are set, the
# maintenance cron kicks the sweeps EVENT-DRIVEN (deterministic per-day job
# ids; retries are duplicates); otherwise the trigger runs the bounded
# sweeps inline. The jobs are delivered to the host's RECEIVER endpoint
# (/api/maintenance/receiver, RL-110), which VERIFIES the QStash signature
# before acting using QSTASH_CURRENT_SIGNING_KEY / QSTASH_NEXT_SIGNING_KEY
# (above): unset keys -> the receiver refuses EVERY delivery (fail-closed).
ROAMLINK_MAINTENANCE_DESTINATION=

# --- Webhook ingress signing keys (RL-117 §7 acceptance) ---------------------
# ROAMLINK_WEBHOOK_SIGNING_KEYS: the ingress signing-key REGISTRY the host
# composes the HmacWebhookVerifier over (comma-separated `keyId:secret`
# pairs). Unset -> EVERY delivery is rejected fail-closed (no default
# secret exists in code); configured + well-formed is the §7 "webhook
# signatures are configured" acceptance state — the demo-acceptance gate
# (infra/deployment/demo-acceptance, runbook §8.1) validates its PRESENCE
# and shape. A malformed registry refuses the host boot. Optional
# ROAMLINK_WEBHOOK_ENVIRONMENT pins the verifier's environment
# ("sandbox" | "production"; default sandbox).
ROAMLINK_WEBHOOK_SIGNING_KEYS=
ROAMLINK_WEBHOOK_ENVIRONMENT=

# --- Deployment verification batteries (RL-111/RL-112) -----------------------
# ROAMLINK_BACKUP_SCRATCH_DATABASE_URL: the SCRATCH PostgreSQL DSN the RL-111
# restore leg runs into (a SECOND/derived database — NEVER the source; the
# battery refuses to run when it equals DATABASE_URL). Unset -> the restore
# leg skips with the named reason. The battery reads DATABASE_URL + the R2
# keys above for the export/upload legs; no credential is ever committed.
ROAMLINK_BACKUP_SCRATCH_DATABASE_URL=

# --- Ops §11 SLO dashboard (RL-109) ------------------------------------------
# ROAMLINK_SLO_OBJECTIVES: the deployment's budgeted §11 SLO objectives,
# comma-separated `id:targetRatio:windowMs[:atRiskBurnRate]` entries keyed
# by the closed §11 SLO ids (see packages/observability slo-metrics.ts
# PRODUCT_SLO_IDS). The /ops/slo operator surface (session-gated, org:read)
# renders their REAL evaluations; ids left unconfigured are honestly
# "measured-only" there — never silently classified. Example shape (values
# are operator decisions, never invented defaults):
#   intent-satisfaction-rate:0.99:86400000,provider-access-failover-success:0.995:604800000
ROAMLINK_SLO_OBJECTIVES=

# --- ADCOS boundary (root env schema, RL-001) --------------------------------
# The PRODUCTION COMPATIBILITY PROBE (RL-108) runs against this endpoint:
#   `pnpm --filter @roamlink/workers adcos:probe`  (also composed in the
#   worker host as a readiness dependency). Exit codes are DISTINCT:
#   0 compatible | 1 incompatible (mutations fail closed) | 2 not-configured.
# Configuration is ALL-OR-NOTHING: when any of the four keys below is set,
# ALL four are required (the deployment refuses to be half-configured).
# ADCOS_API_VERSION, if set, MUST equal the ONE pinned supported version
# (the single-site pin - environment overrides cannot fork it). Optional
# probe resource ids (ADCOS_PROBE_INTENT_ID / _CONTRACT_ID / _LEASE_ID)
# enable the server-side route checks when seeded out-of-band. No real
# credential ever lands in a committed file (RL-LOCK-016).
ADCOS_API_BASE_URL=
ADCOS_API_VERSION=
ADCOS_CLIENT_ID=
ADCOS_CLIENT_SECRET=
ADCOS_WEBHOOK_SECRET=
