# =============================================================================
# RoamLink ENVIRONMENT TEMPLATE - preview (RL-099)
# spec/deployment.md §6: Vercel preview deployments.
# VALUES STAY EMPTY. Real values live ONLY in the preview environment's
# secret store. Preview MUST NOT receive production ADCOS credentials and
# MUST NOT share any provider resource with production (separate Neon
# project/branch, separate Redis, QStash, R2 and webhook secrets).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
ROAMLINK_API_BASE_URL=
ROAMLINK_PUBLIC_API_URL=

# --- Durable source of truth: Neon PostgreSQL (RL-095) -----------------------
# Use a Neon BRANCH of the development project for preview (isolated).
DATABASE_URL=
NEON_DIRECT_URL=

# --- Bounded accelerator: Upstash Redis (RL-096) -----------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Retryable async delivery: Upstash QStash (RL-097) -----------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# --- Large artifacts: Cloudflare R2 (RL-098) ---------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- ADCOS boundary (root env schema, RL-001) --------------------------------
# NEVER the production ADCOS credentials here (deployment.md §6).
ADCOS_API_BASE_URL=
ADCOS_API_VERSION=
ADCOS_CLIENT_ID=
ADCOS_CLIENT_SECRET=
ADCOS_WEBHOOK_SECRET=
