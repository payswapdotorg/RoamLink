# Neon (PostgreSQL durable source of truth) - environment template (RL-095)
#
# Copy the RELEVANT KEYS ONLY into the target environment's secret store
# (Vercel project settings / secret manager). NEVER commit real values.
# Per-environment values MUST differ (spec/deployment.md §6).
#
# DATABASE_URL is owned by the root env schema (packages/contracts, RL-001);
# @roamlink/provider-neon refines it (TLS enforced, pooled/direct
# classification). See runbooks/neon-provisioning.md.

# Pooled endpoint (host contains a `-pooler` DNS label): default for
# serverless/request paths.
DATABASE_URL=

# Direct endpoint (no `-pooler` label): migrations + long-running workers
# only. Store it under its own secret name; RoamLink reads DATABASE_URL for
# the request path and this one explicitly for migration jobs.
NEON_DIRECT_URL=
