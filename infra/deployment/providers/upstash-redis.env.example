# Upstash Redis (bounded ephemeral accelerator) - environment template (RL-096)
#
# Copy the RELEVANT KEYS ONLY into the target environment's secret store.
# NEVER commit real values. Per-environment values MUST differ
# (spec/deployment.md §6). Redis is OPTIONAL per environment: leaving these
# keys unset runs the non-accelerated path (the system stays correct).
#
# Create keys in the Upstash console (REST API database). The REST URL is
# https; the REST token is the bearer credential.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
