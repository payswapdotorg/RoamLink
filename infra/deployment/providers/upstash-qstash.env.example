# Upstash QStash (retryable async delivery) - environment template (RL-097)
#
# Copy the RELEVANT KEYS ONLY into the target environment's secret store.
# NEVER commit real values. Per-environment values MUST differ.
#
# QSTASH_TOKEN: the publish credential (client side).
# QSTASH_CURRENT_SIGNING_KEY / QSTASH_NEXT_SIGNING_KEY: receiver-side
#   signature verification keys; keep BOTH configured so rotation never
#   drops a delivery (the verifier accepts either during rollover).
# QSTASH_URL: optional endpoint override; the pinned default is
#   https://qstash.upstash.io.

QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=
