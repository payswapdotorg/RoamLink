{
  "name": "@roamlink/workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vitest",
    "start": "tsx ./src/main.ts",
    "adcos:probe": "tsx ./scripts/adcos-probe.ts"
  },
  "dependencies": {
    "@roamlink/adcos": "workspace:*",
    "@roamlink/api-service": "workspace:*",
    "@roamlink/compat": "workspace:*",
    "@roamlink/contracts": "workspace:*",
    "@roamlink/edge-connector": "workspace:*",
    "@roamlink/enterprise": "workspace:*",
    "@roamlink/integration": "workspace:*",
    "@roamlink/observability": "workspace:*",
    "@roamlink/persistence": "workspace:*",
    "@roamlink/persistence-postgres": "workspace:*",
    "@roamlink/projections": "workspace:*",
    "@roamlink/provider-qstash": "workspace:*",
    "@roamlink/reconciliation": "workspace:*",
    "@roamlink/webhook-inbox": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@roamlink/auth": "workspace:*",
    "@roamlink/testkit": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.8.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
