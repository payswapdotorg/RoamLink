{
  "name": "@roamlink/root",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm architecture:check",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "architecture:check": "node scripts/check-architecture.mjs",
    "mvp-gate": "node scripts/release/mvp-gate.mjs",
    "production-gate": "node scripts/release/production-gate.mjs",
    "dev": "pnpm -r --parallel --if-present dev",
    "prepare": "node scripts/hooks/install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
